@model WebUILayer.Areas.Admin.Models.GuestBookIndexViewModel
@{
    ViewData["Title"] = "Ziyaretçi Defteri";
    ViewData["BodyClass"] = "guestbook-page";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="/Mytheme/admin/css/modules/messages.css">
    <link rel="stylesheet" href="/Mytheme/admin/css/modules/guestbook.css">
}

<!-- SEKMELER (TABS) -->
<div class="mb-20" style="display: flex; gap: 10px; margin-bottom: 20px;">
    <a href="/Admin/GuestBooks/Index?tab=pending"
           class="btn @(Model.ActiveTab == "pending" ? "btn-primary" : "btn-outline")">
        <i class="fas fa-clock"></i> Onay Bekleyenler
    </a>
    <a href="/Admin/GuestBooks/Index?tab=approved"
           class="btn @(Model.ActiveTab == "approved" ? "btn-primary" : "btn-outline")">
        <i class="fas fa-check-double"></i> Onaylananlar ve Arşiv
    </a>
</div>

<!-- TEK VE AKILLI TABLO -->
<div class="card">
    <div class="card-header">
        <h3>@(Model.ActiveTab == "pending" ? "Onay Bekleyen Yorumlar" : "Onaylananlar ve Arşiv")</h3>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>Mesaj</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                    <th>Görünürlük</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Messages.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Bu sekmede kayıt bulunmuyor.</td>
                    </tr>
                }
                
                @foreach (var item in Model.Messages)
                {
                    <tr class="@(item.IsDeleted ? "deleted-item" : "")">
                        <td>
                            <div class="author-wrapper">
                                <img src="@item.AuthorAvatarUrl" alt="@item.AuthorName"
                                     onerror="this.src='/Mytheme/portfolio/images/default-avatar.png'">
                                <div>
                                    <strong>@item.AuthorName</strong>
                                    <p class="author-meta">Ziyaretçi</p>
                                </div>
                            </div>
                        </td>
                        <td class="comment-text">@(item.Message.Length > 60 ? item.Message.Substring(0, 60) + "..." : item.Message)</td>
                        
                        <!-- DURUMLAR VE BUTONLAR DİNAMİK YÜKLENİR -->
                        @if (item.IsDeleted)
                        {
                            <td><span class="status-badge danger">Silindi</span></td>
                            <td>@item.CreatedAt.AddHours(3).ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="status-badge danger">Sitede Gizli</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="action-btn" title="Görüntüle" data-action="viewComment"><i class="fas fa-eye"></i></button>
                                    <form asp-action="Restore" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn restore" title="Geri Yükle"><i class="fas fa-undo"></i></button>
                                    </form>
                                </div>
                            </td>
                        }
                        else if (item.IsApproved)
                        {
                            <td><span class="status-badge active">Onaylandı</span></td>
                            <td>@item.CreatedAt.AddHours(3).ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="status-badge active">Sitede Aktif</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="action-btn" title="Görüntüle" data-action="viewComment"><i class="fas fa-eye"></i></button>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn delete" title="Sil"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        }
                        else
                        {
                            <!-- Bekleyenler -->
                            <td><span class="status-badge warning">Onay Bekliyor</span></td>
                            <td>@item.CreatedAt.AddHours(3).ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="status-badge draft">Gizli</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="action-btn" title="Görüntüle" data-action="viewComment"><i class="fas fa-eye"></i></button>
                                    <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn success" title="Onayla"><i class="fas fa-check"></i></button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn delete" title="Reddet/Sil"><i class="fas fa-times"></i></button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @await Component.InvokeAsync("_LayoutPaginationPartialComponent",
        new { currentPage = Model.CurrentPage, totalPages = Model.TotalPages, extraRouteValues = new Dictionary<string, string> { { "tab", Model.ActiveTab } } })
</div>


<!-- Yorum Görüntüleme Modalı -->
<div id="commentModal" class="admin-modal-overlay">
    <div class="admin-modal">
        <div class="modal-header">
            <div class="modal-header-container">
                <div class="modal-icon modal-icon-custom"><i class="fas fa-comment-dots"></i></div>
                <h4 class="modal-title-custom">Yorum Detayı</h4>
            </div>
            <button class="modal-close" data-action="closeModal"><i class="fas fa-times"></i></button>
        </div>
        <div class="modal-body-custom">
            <div class="modal-meta">
                <strong id="modalUserName"></strong>
                <span style="margin-left:10px;"><i class="fas fa-clock fa-clock-custom"></i> <span id="modalDate"></span></span>
            </div>
            <textarea id="modalMessage" class="modal-message" readonly></textarea>
        </div>
        <div class="modal-footer-custom">
            <button id="approveBtn" class="btn btn-success btn-approve-custom hidden">
                <i class="fas fa-check"></i> Onayla
            </button>
            <button id="restoreBtn" class="btn btn-warning hidden">
                <i class="fas fa-undo"></i> Geri Yükle
            </button>
            <button class="btn btn-outline" data-action="closeModal">Kapat</button>
        </div>
    </div>
</div>

<!-- Silme Onay Modalı -->
<div id="deleteConfirmModal" class="admin-modal-overlay">
    <div class="admin-modal" style="text-align:center; padding:25px;">
        <div class="modal-icon modal-icon-delete" style="width:50px;height:50px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:15px;">
            <i class="fas fa-trash-alt"></i>
        </div>
        <h4>Silme Onayı</h4>
        <p style="margin:10px 0;"><strong id="deleteItemName"></strong> adlı kullanıcının yorumunu silmek istediğinize emin misiniz?</p>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:20px;">
            <button id="cancelDelete" class="btn btn-outline">İptal</button>
            <button id="confirmDelete" class="btn btn-danger">Sil</button>
        </div>
    </div>
</div>

<!-- Geri Yükleme Onay Modalı -->
<div id="restoreModal" class="admin-modal-overlay">
    <div class="admin-modal" style="text-align:center; padding:25px;">
        <div class="modal-icon modal-icon-restore" style="width:50px;height:50px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;margin-bottom:15px;">
            <i class="fas fa-undo"></i>
        </div>
        <h4>Geri Yükleme Onayı</h4>
        <p style="margin:10px 0;"><strong id="restoreItemName"></strong> adlı kullanıcının yorumunu geri yüklemek istediğinize emin misiniz?</p>
        <div style="display:flex;gap:10px;justify-content:center;margin-top:20px;">
            <button id="cancelRestore" class="btn btn-outline">İptal</button>
            <button id="confirmRestore" class="btn btn-warning">Geri Yükle</button>
        </div>
    </div>
</div>


<!-- Modal Kodların (Silme Onayı vb.) Aynı Şekilde Altta Kalacak -->
