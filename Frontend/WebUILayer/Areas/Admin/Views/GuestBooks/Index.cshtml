@model WebUILayer.Areas.Admin.Models.GuestBookIndexViewModel
@{
    ViewData["Title"] = "Ziyaretçi Defteri";
    ViewData["BodyClass"] = "guestbook-page";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="/Mytheme/admin/css/modules/messages.css">
    <link rel="stylesheet" href="/Mytheme/admin/css/modules/guestbook.css">
}

<!-- SEKMELER (TABS) -->
<div class="mb-20" style="display: flex; gap: 10px; margin-bottom: 20px;">
    <a href="/Admin/GuestBooks/Index?tab=pending"
           class="btn @(Model.ActiveTab == "pending" ? "btn-primary" : "btn-outline")">
        <i class="fas fa-clock"></i> Onay Bekleyenler
    </a>
    <a href="/Admin/GuestBooks/Index?tab=approved"
           class="btn @(Model.ActiveTab == "approved" ? "btn-primary" : "btn-outline")">
        <i class="fas fa-check-double"></i> Onaylananlar ve Arşiv
    </a>
</div>

<!-- TEK VE AKILLI TABLO -->
<div class="card">
    <div class="card-header">
        <h3>@(Model.ActiveTab == "pending" ? "Onay Bekleyen Yorumlar" : "Onaylananlar ve Arşiv")</h3>
    </div>
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>Mesaj</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                    <th>Görünürlük</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Messages.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Bu sekmede kayıt bulunmuyor.</td>
                    </tr>
                }
                
                @foreach (var item in Model.Messages)
                {
                    <tr class="@(item.IsDeleted ? "deleted-item" : "")">
                        <td>
                            <div class="author-wrapper">
                                <img style="height:40px" src="@item.AuthorAvatarUrl" alt="@item.AuthorName" class="author-avatar">
                                <div>
                                    <strong>@item.AuthorName</strong>
                                    <p class="author-meta">Ziyaretçi</p>
                                </div>
                            </div>
                        </td>
                        <td class="comment-text">@(item.Message.Length > 60 ? item.Message.Substring(0, 60) + "..." : item.Message)</td>
                        
                        <!-- DURUMLAR VE BUTONLAR DİNAMİK YÜKLENİR -->
                        @if (item.IsDeleted)
                        {
                            <td><span class="status-badge danger">Silindi</span></td>
                            <td>@item.CreatedAt.AddHours(3).ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="status-badge danger">Sitede Gizli</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="action-btn" title="Görüntüle" data-action="viewComment"><i class="fas fa-eye"></i></button>
                                    <form asp-action="Restore" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn restore" title="Geri Yükle"><i class="fas fa-undo"></i></button>
                                    </form>
                                </div>
                            </td>
                        }
                        else if (item.IsApproved)
                        {
                            <td><span class="status-badge active">Onaylandı</span></td>
                            <td>@item.CreatedAt.AddHours(3).ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="status-badge active">Sitede Aktif</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="action-btn" title="Görüntüle" data-action="viewComment"><i class="fas fa-eye"></i></button>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn delete" title="Sil"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        }
                        else
                        {
                            <!-- Bekleyenler -->
                            <td><span class="status-badge warning">Onay Bekliyor</span></td>
                            <td>@item.CreatedAt.AddHours(3).ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="status-badge draft">Gizli</span></td>
                            <td>
                                <div class="action-btns">
                                    <button class="action-btn" title="Görüntüle" data-action="viewComment"><i class="fas fa-eye"></i></button>
                                    <form asp-action="Approve" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn success" title="Onayla"><i class="fas fa-check"></i></button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="action-btn delete" title="Reddet/Sil"><i class="fas fa-times"></i></button>
                                    </form>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @await Component.InvokeAsync("_LayoutPaginationPartialComponent",
        new { currentPage = Model.CurrentPage, totalPages = Model.TotalPages, extraRouteValues = new Dictionary<string, string> { { "tab", Model.ActiveTab } } })
</div>

<!-- Modal Kodların (Silme Onayı vb.) Aynı Şekilde Altta Kalacak -->
