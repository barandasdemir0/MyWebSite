@model List<NotificationDto>

<header class="admin-header">
    <button class="menu-toggle"><i class="fas fa-bars"></i></button>
    <div class="page-title">
        <h1>Admin Temasına Hoşgeldiniz</h1>
        <p>Buradan yeni içerikler oluşturabilirsiniz Ve Sitenizi Yönetebilirsiniz.</p>
    </div>


    <div id="aboutConfig" class="hidden"
         data-msg-select-image="Lütfen bir resim dosyası seçin (PNG, JPG, vb.)"
         data-msg-enter-url="Lütfen geçerli bir URL girin."
         data-msg-photo-updated="Profil fotoğrafı güncellendi."
         data-msg-photo-removed="Profil fotoğrafı kaldırıldı."></div>

    <div class="header-actions">

        <a href="../index.html" target="_blank" class="btn-icon" title="Siteye Git">
            <i class="fas fa-external-link-alt"></i>
        </a>

     
        <button class="btn-icon notification-btn">
            <i class="fas fa-bell"></i>
            <span class="notification-badge">3</span>

        </button>

        <!-- Notification Dropdown (Örnek) -->
        <div class="nav-item dropdown dropdown-notification me-25">
            <a class="nav-link" href="#" data-bs-toggle="dropdown">
                <i class="ficon" data-feather="bell"></i>
                @if (Model.Count > 0)
                {
                    <span class="badge rounded-pill bg-danger badge-up">@Model.Count</span>
                }
            </a>
    
            <ul class="dropdown-menu dropdown-menu-media dropdown-menu-end">
                <li class="dropdown-menu-header">
                    <div class="dropdown-header d-flex">
                        <h4 class="notification-title mb-0 me-auto">Bildirimler</h4>
                    </div>
                </li>
                <li class="scrollable-container media-list">
                    @if (Model.Count == 0)
                    {
                        <div class="p-3 text-center text-muted">Yeni bildiriminiz yok.</div>
                    }
                    @foreach (var item in Model)
                    {
                        string iconClass = "fa-info";
                        string bgClass = "bg-primary";
                        if (item.Type == "comment") { iconClass = "fa-comment"; bgClass = "bg-info"; }
                        else if (item.Type == "project") { iconClass = "fa-check"; bgClass = "bg-success"; }
                        else if (item.Type == "system") { iconClass = "fa-exclamation-triangle"; bgClass = "bg-warning"; }
                        else if (item.Type == "user") { iconClass = "fa-user"; bgClass = "bg-secondary"; }
                        // Güvenlik için formu POST atıyoruz
                        <form asp-area="Admin" asp-controller="Notifications" asp-action="Read" method="post" class="d-flex">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="dropdown-item d-flex align-items-start w-100 border-0 bg-transparent text-start">
                                <div class="me-1">
                                    <div class="avatar @bgClass">
                                        <div class="avatar-content"><i class="fas @iconClass"></i></div>
                                    </div>
                                </div>
                                <div class="list-item-body flex-grow-1">
                                    <p class="media-heading"><span class="fw-bolder">@item.Message</span></p>
                                </div>
                            </button>
                        </form>
                    }
                </li>
                <li class="dropdown-menu-footer">
                    <a class="btn btn-primary w-100" asp-area="Admin" asp-controller="Notifications" asp-action="Index">Tüm Bildirimleri Gör</a>
                </li>
            </ul>
        </div>

  


        <div class="user-profile" data-action="navigateTo" data-href="profile.html">
            <img src="https://ui-avatars.com/api/?name=Baran+D&background=6366f1&color=fff" alt="Admin">
            <div class="user-info">
                <h4>Baran Dasdemir</h4>
                <span>Administrator</span>
            </div>
        </div>
    </div>
</header>