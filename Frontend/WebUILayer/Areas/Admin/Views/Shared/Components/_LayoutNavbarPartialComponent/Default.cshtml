@model List<NotificationDto>

<header class="admin-header">
    <!-- Hamburger Butonu (Mobile için şart) -->
    <button class="menu-toggle"><i class="fas fa-bars"></i></button>

    <div class="page-title">
        <h1>Admin Paneline Hoşgeldiniz</h1>
        <p>Buradan yeni içerikler oluşturabilirsiniz Ve Sitenizi Yönetebilirsiniz.</p>
    </div>

    <div id="aboutConfig" class="hidden"
         data-msg-select-image="Lütfen bir resim dosyası seçin (PNG, JPG, vb.)"
         data-msg-enter-url="Lütfen geçerli bir URL girin."
         data-msg-photo-updated="Profil fotoğrafı güncellendi."
         data-msg-photo-removed="Profil fotoğrafı kaldırıldı."></div>

    <!-- margin-left:auto ile SAĞ köşeye yaslar -->
    <div class="header-actions" style="margin-left: auto; display: flex; align-items: center; gap: 12px;">

        <!-- Siteye Git Butonu -->
        <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" class="btn-icon" title="Siteye Git">
            <i class="fas fa-external-link-alt"></i>
        </a>

        <!-- Bildirim Butonu (Temanın Orijinal Yapısı) -->
        <button class="btn-icon notification-btn">
            <i class="fas fa-bell"></i>
            @if (Model.Count > 0)
            {
                <span class="notification-badge">@Model.Count</span>
            }
        </button>

        <!-- Temanın Orijinal Bildirim Dropdown'ı -->
        <div class="notification-dropdown">
            <div class="dropdown-header">
                <h4>Bildirimler</h4>
            </div>
            <div class="dropdown-content">
                @if (Model.Count == 0)
                {
                    <div class="p-4 text-center text-muted">Yeni bildiriminiz yok.</div>
                }
                @foreach (var item in Model)
                {
                    string iconClass = "fa-info";
                    string colorClass = "icon-blue";
                    string typeTitle = "Bilgi";
                    if (item.Type == "comment") { iconClass = "fa-comment-alt"; colorClass = "icon-blue"; typeTitle = "Yeni Yorum"; }
                    else if (item.Type == "project") { iconClass = "fa-check-circle"; colorClass = "icon-green"; typeTitle = "Proje Onaylandı"; }
                    else if (item.Type == "system") { iconClass = "fa-exclamation-triangle"; colorClass = "icon-yellow"; typeTitle = "Sistem Uyarısı"; }
                    else if (item.Type == "user") { iconClass = "fa-user-plus"; colorClass = "icon-purple"; typeTitle = "Yeni Üye"; }

                    <form asp-area="Admin" asp-controller="Notifications" asp-action="Read" method="post">
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="notification-item unread border-0 w-100 text-start bg-transparent p-0" style="cursor:pointer; display:flex;">
                            <div class="notif-icon @colorClass">
                                <i class="fas @iconClass"></i>
                            </div>
                            <div class="notif-info">
                                <h5>@typeTitle</h5>
                                <p>@item.Message</p>
                            </div>
                        </button>
                    </form>
                }
            </div>
            <div class="dropdown-footer">
                <a class="view-all-btn" style="text-decoration:none; display:block; text-align:center;"
                       asp-area="Admin" asp-controller="Notifications" asp-action="Index">
                    Tüm Bildirimleri Gör
                </a>
            </div>
        </div>

        <!-- Kullanıcı Profili -->
        <div class="user-profile">
            <img src="https://ui-avatars.com/api/?name=Baran+D&background=6366f1&color=fff" alt="Admin">
            <div class="user-info">
                <h4>Baran Dasdemir</h4>
                <span>Administrator</span>
            </div>
        </div>
    </div>
</header>
