@model UpdateSiteSettingDto
@{
    ViewData["Title"] = "Index";
    ViewData["BodyClass"] = "settings-page";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="/Mytheme/admin/css/modules/settings.css">
}

<form asp-action="Index" method="post">
    <!-- Settings Cards -->
    <div class="content-grid">
        <!-- Availability Status -->
        <div class="card">
            <div class="card-header">
                <h3>
                    <i class="fas fa-circle circle-icon"></i>Müsaitlik
                    Durumu
                </h3>
            </div>


            <div class="form-group">
                <label>Durum Mesajı</label>
                <textarea class="form-control" asp-for="WorkStatus" placeholder="Örn: Yeni projelere açığım"
                          rows="3">Yeni projelere açığım</textarea>
                <p class="input-hint">
                    Profil ve iletişim sayfalarında görünecek
                    kısa durum mesajı.
                </p>
            </div>

            <div class="form-group">
                <label>Durum Rengi (Anlamı)</label>
                <div class="status-selector">
                    <label>
                        <input asp-for="IsAvailable" type="radio" value="true" checked>
                        <div class="status-color-dot success">
                        </div>
                        <span>Müsait (Yeşil)</span>
                    </label>
                    <label>
                        <input asp-for="IsAvailable" type="radio" value="false">
                        <div class="status-color-dot warning">
                        </div>
                        <span>Meşgul (Sarı)</span>
                    </label>
                    <!-- Removed 'Kapalı (Kırmızı)' option as per user request -->
                </div>
            </div>



        </div>

        <!-- CV Download Settings -->
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-file-pdf pdf-icon"></i>CV İndirme Ayarları</h3>
            </div>


            <div class="form-group">
                <label>Türkçe CV (PDF)</label>
                <input type="url" asp-for="CvFileUrlTr" class="form-control pdf-input" accept=".pdf">
            </div>
            <div class="form-group">
                <label>İngilizce CV (PDF)</label>
                <input type="url" asp-for="CvFileUrlEn" class="form-control pdf-input" accept=".pdf">
            </div>

            <div class="form-group">
                <label>Mevcut Dosyalar</label>
                <div class="file-list">
                    <div class="file-row">
                        <span class="file-label">TR:</span>
                        <input type="text" class="form-control file-input" value="@Model.CvFileUrlTr"
                               readonly>
                        <a href="@Model.CvFileUrlTr" class="btn btn-outline btn-sm download-btn">
                            <i class="fas fa-download"></i>
                        </a>
                    </div>
                    <div class="file-row">
                        <span class="file-label">EN:</span>
                        <input type="text" class="form-control file-input" value="@Model.CvFileUrlEn"
                               readonly>
                        <a href="@Model.CvFileUrlEn" class="btn btn-outline btn-sm download-btn">
                            <i class="fas fa-download"></i>
                        </a>
                    </div>
                </div>
            </div>

            @*     <div class="form-actions">
                <button type="button" class="btn btn-success" data-action="saveCV">
                    <i class="fas fa-save"></i>
                    CV'leri Güncelle
                </button>
            </div> *@

        </div>
        <div class="card">
            <div class="card-header">
                <h3><i class="fas fa-share-alt mr-10"></i>Seo Ayarları</h3>
            </div>

            <div class="form-group">
                <label><i class="fas fa-heading mr-5"></i>Site İsmi (Title)</label>
                <input type="text" class="form-control" asp-for="SiteTitle" placeholder="Örn: Baran Dasdemir | Web Developer">
                <span asp-validation-for="SiteTitle" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label><i class="fas fa-tags mr-5"></i>Site Anahtar Kelimeleri (Keywords)</label>
                <input type="text" class="form-control" asp-for="SiteKeywords" placeholder="Örn: yazılım, developer, portfolyo, .net">
                <span asp-validation-for="SiteKeywords" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label><i class="fas fa-file-alt mr-5"></i>Meta Açıklaması (Description)</label>
                <textarea class="form-control" rows="3" asp-for="MetaDescription" placeholder="Örn: Baran Dasdemir kişisel portfolyo ve blog web sitesi."></textarea>
                <span asp-validation-for="MetaDescription" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label><i class="fas fa-image mr-5"></i>Varsayılan SEO Görseli (URL)</label>
                <input type="text" class="form-control" asp-for="DefaultSeoImageUrl" placeholder="Örn: /images/seo-banner.jpg (Sosyal medya paylaşımlarında çıkacak resim)">
                <span asp-validation-for="DefaultSeoImageUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label><i class="fas fa-chart-line mr-5"></i>Google Analytics ID</label>
                <input type="text" class="form-control" asp-for="GoogleAnalyticsId" placeholder="Örn: G-XXXXXXXXXX">
                <span asp-validation-for="GoogleAnalyticsId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label><i class="fas fa-chart-pie mr-5"></i>Microsoft Clarity ID</label>
                <input type="text" class="form-control" asp-for="MicrosoftClarityId" placeholder="Örn: abcdefghij">
                <span asp-validation-for="MicrosoftClarityId" class="text-danger"></span>
            </div>
        </div>

        <div class="form-check form-switch mb-3">
            <div class="card mt-3">
                <div class="card-header"><h3><i class="fas fa-tools"></i> Bakım Modu Ayarları</h3></div>
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsMaintenanceMode" id="isMaintenanceMode" role="switch" />
                        <label class="form-check-label" for="isMaintenanceMode">
                            <span class="text-warning fw-semibold">Siteyi Bakım Moduna Al</span>
                        </label>
                    </div>

                    <div class="form-group">
                        <label>Bakım Mesajı</label>
                        <textarea class="form-control" asp-for="MaintenanceMessage" rows="2" placeholder="Örn: Veritabanı güncellemesi yapılıyor."></textarea>
                        <span asp-validation-for="MaintenanceMessage" class="text-danger"></span>
                    </div>

                    <div class="form-group mt-2">
                        <label>Tahmini Bitiş Tarihi</label>
                        <input type="datetime-local" class="form-control" asp-for="MaintenanceEndTime" />
                        <span asp-validation-for="MaintenanceEndTime" class="text-danger"></span>
                    </div>
                </div>
            </div>

          

        </div>

    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-success" data-action="saveStatus">
            <i class="fas fa-save"></i>
            Ayarları Güncelle
        </button>
    </div>
</form>

@section scripts {
    <script src="/Mytheme/admin/js/modules/settings.js"></script>
}
