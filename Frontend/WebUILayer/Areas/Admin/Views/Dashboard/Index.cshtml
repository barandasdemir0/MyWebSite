@model WebUILayer.Areas.Admin.Models.DashboardIndexViewModel
@{
    ViewData["Title"] = "Index";
    ViewData["BodyClass"] = "index-page dashboard-page-mod";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="/Mytheme/Admin/css/modules/index.css">
}

<!-- Stats -->
<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-icon projects">
            <i class="fas fa-folder-open"></i>
        </div>
        <div class="stat-info">
            <h3>12</h3>
            <p>Toplam Proje</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon blog">
            <i class="fas fa-file-alt"></i>
        </div>
        <div class="stat-info">
            <h3>8</h3>
            <p>Blog Yazısı</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon visitors">
            <i class="fas fa-users"></i>
        </div>
        <div class="stat-info">
            <h3>1,248</h3>
            <p>Bu Ay Ziyaretçi</p>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-icon messages">
            <i class="fas fa-envelope"></i>
        </div>
        <div class="stat-info">
            <h3>24</h3>
            <p>Yeni Mesaj</p>
        </div>
    </div>
</div>

<!-- Content Grid (New Strict Grid Layout) -->
<div class="content-grid dashboard-grid-layout">
    <!-- 1. Projects Card -->
    <div class="card card-projects">
        <div class="card-header">
            <h3>Son Projeler</h3>
            <a asp-controller="Project" asp-action="Index" class="btn btn-sm btn-outline">Tümünü Gör</a>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Proje Adı</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.projectListDtos)
                    {

                        <tr>
                            <td>@item.Name</td>
                            <td>@string.Join(", ", item.Topics)</td>
                            <td><span class="status-badge active">Yayında</span></td>
                        </tr>


                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 2. Blogs Card -->
    <div class="card card-blogs">
        <div class="card-header">
            <h3>Son Blog Yazıları</h3>
            <a asp-controller="BlogPosts" asp-action="Index" class="btn btn-sm btn-outline">Tümünü Gör</a>
        </div>
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.blogPostListDtos)
                    {
                        <tr>
                            <td>@item.Title</td>
                            <td>@string.Join(", ", item.Topics)</td>

                            <td><span class="status-badge active">Yayında</span></td>


                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>

    <!-- 3. Quick Actions Card (Full Height) -->
    <div class="card quick-actions-card">
        <div class="card-header">
            <h3>Hızlı İşlemler</h3>
        </div>
        <div class="quick-actions">
            <a asp-area="Admin" asp-controller="Project" asp-action="Index" class="quick-action-btn">
                <i class="fas fa-plus"></i>
                <div>
                    <strong>Yeni Proje Ekle</strong>
                    <p>Portfolio'ya yeni proje</p>
                </div>
            </a>
            <a asp-area="Admin" asp-controller="BlogPosts" asp-action="Index" class="quick-action-btn">
                <i class="fas fa-pen"></i>
                <div>
                    <strong>Blog Yazısı Yaz</strong>
                    <p>Yeni makale oluştur</p>
                </div>
            </a>
            <a asp-area="Admin" asp-controller="Messages" asp-action="Index" class="quick-action-btn">
                <i class="fas fa-paper-plane"></i>
                <div>
                    <strong>Mesaj Gönder</strong>
                    <p>Hızlı e-posta gönder</p>
                </div>
            </a>
            <a asp-area="Admin" asp-controller="Topic" asp-action="Index" class="quick-action-btn">
                <i class="fas fa-tags"></i>
                <div>
                    <strong>Kategori Yönetimi</strong>
                    <p>Etiketleri düzenle</p>
                </div>
            </a>
            <a asp-area="Admin" asp-controller="GithubRepo" asp-action="Index" class="quick-action-btn">
                <i class="fab fa-github"></i>
                <div>
                    <strong>Github Senkronizasyonu</strong>
                    <p>Repoları güncelle</p>
                </div>
            </a>
            <a asp-area="Admin" asp-controller="Security" asp-action="Index" class="quick-action-btn">
                <i class="fas fa-toggle-on"></i>
                <div>
                    <strong>Müsaitlik Durumu</strong>
                    <p>Şu an: <span class="status-text">Müsait</span></p>
                </div>
            </a>
        </div>
    </div>

    <!-- 4. Comments Card -->
    <div class="card card-comments">
        <div class="card-header">
            <h3>Son Yorumlar</h3>
            <a asp-area="Admin" asp-controller="GuestBooks" asp-action="Index" class="btn btn-sm btn-outline">Tümü</a>
        </div>
        <div class="dashboard-list">
            @foreach (var item in Model.guestBookListDtos)
            {
                <div class="dashboard-item">
                    <div class="item-content">
                        <strong class="item-name">@item.AuthorName</strong>
                        <p class="item-text">"@item.Message"</p>
                    </div>
                </div>
            }
          
           
        </div>
    </div>

    <!-- 5. Messages Card -->
    <div class="card card-messages">
        <div class="card-header">
            <h3>Son Mesajlar</h3>
            <a asp-area="Admin" asp-controller="Messages" asp-action="Index" class="btn btn-sm btn-outline">Tümü</a>
        </div>
        <div class="dashboard-list">
            @foreach (var item in Model.messageListDtos)
            {
                <div class="dashboard-item message-item">
                    <div class="item-content">
                        <div class="item-header">
                            <strong class="item-name">@item.SenderName</strong>
                            <span class="item-meta">@item.CreatedAt.AddHours(3).ToString("dd MMM yyyy HH:mm")</span>
                        </div>
                    </div>
                </div>
            }
            
        </div>
    </div>
</div>
