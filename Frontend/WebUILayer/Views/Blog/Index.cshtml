@using WebUILayer.Extension
@model BlogViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles{

}

<!-- PAGE HEADER -->
<section class="section blog-header-section" style="background: var(--bg-secondary);">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-subtitle">Yazılar & Makaleler</p>
            <h1 class="section-title">Teknoloji <span class="gradient-text">Blogu</span></h1>
            <div class="section-line"></div>
        </div>
    </div>
</section>

<!-- BLOG SECTION -->
<section class="section blog-section" style="padding-top: 40px;">
    <div class="container">
        <!-- Search Box -->
        <div class="search-box" data-aos="fade-up" id="blogSearch">
            <input type="text" class="search-input" id="searchInput" placeholder="Yazılarda ara...">
            <button class="search-clear" id="searchClear"><i class="fas fa-times"></i></button>
            <i class="fas fa-search search-icon"></i>
        </div>

        <!-- Category Filters -->
        <div class="portfolio-filters" data-aos="fade-up" style="margin-bottom: 50px;">
            <button class="filter-btn active" data-filter="*">Tümü</button>
            @foreach (var topic in Model.topicDtos)
            {
                <button class="filter-btn" data-filter="@topic.Name">@topic.Name</button>
            }
          
        </div>

        <div class="blog-grid">
            @foreach (var blogs in Model.blogPostListDtos)
            {
                <!-- Blog Post 1 -->
                <article class="blog-card" data-aos="fade-up" data-category="@string.Join(",", blogs.Topics)">
                    <div class="blog-image">
                        <span class="blog-category">@string.Join(", ", blogs.Topics)</span>
                        <img src="@blogs.CoverImage"
                             alt="@string.Join(", ", blogs.Topics)">
                    </div>
                    <div class="blog-content">
                        <div class="blog-meta">
                            <span><i class="far fa-calendar"></i> @blogs.PublishedAt?.ToString("hh MMMM yyyy")</span>
                            <span><i class="far fa-user"></i> @Model.aboutDto?.FullName</span>
                            <span><i class="far fa-clock"></i>@blogs.ReadTime Okuma Süresi</span>
                        </div>
                        <h3 class="blog-title">
                            <a href="/blog/BlogDetail/@blogs.Slug">
                                @blogs.Title
                            </a>
                        </h3>
                        <p class="blog-excerpt">
                            @blogs.Content.StripHtmlAndTruncate(200)
                        </p>
                        <div class="blog-footer">
                            <a href="/blog/BlogDetail/@blogs.Slug" class="read-more">
                                Devamını Oku <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </article>
            }

        </div>

        <div class="mt-4" data-aos="fade-up">
            @await Component.InvokeAsync("LayoutPublicPagination", new { currentPage = Model.CurrentPage, totalPages = Model.TotalPages })
        </div>
    </div>
</section>

@section scripts{
    <script src="~/Mytheme/portfolio/js/blog.js"></script>
}

