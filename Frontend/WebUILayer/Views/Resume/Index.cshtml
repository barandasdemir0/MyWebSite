@model ResumeViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Mytheme/portfolio/css/pages/resume.css">
}

<!-- PAGE HEADER -->
<section class="section resume-header-section">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-subtitle">Kariyerim</p>
            <h1 class="section-title">CV / Özgeçmiş</h1>
            <div class="section-line"></div>
        </div>
    </div>
</section>

<!-- RESUME CONTENT -->
<section class="section resume-section">
    <div class="container">
        <!-- Tabs -->
        <div class="resume-tabs" data-aos="fade-up">
            <button class="resume-tab active" data-tab="experience">
                <i class="fas fa-briefcase me-2"></i>Deneyim
            </button>
            <button class="resume-tab" data-tab="education">
                <i class="fas fa-graduation-cap me-2"></i>Eğitim
            </button>
            <button class="resume-tab" data-tab="certificates">
                <i class="fas fa-certificate me-2"></i>Sertifikalar
            </button>
        </div>

        <!-- Experience Tab -->
        <div class="tab-content active" id="experience">
            <div class="timeline" data-aos="fade-up">
                @foreach (var experience in Model.experienceDtos.OrderBy(x=>x.DisplayOrder))
                {
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <span class="timeline-date">@experience.ExperienceStartDate?.ToString("dd MMMM yyyy") - @experience.ExperienceFinishDate?.ToString("dd MMMM yyyy")</span>
                            <h4>@experience.ExperienceTitle</h4>
                            <h5>@experience.ExperienceCompanyName</h5>
                            <p>
                                @experience.ExperienceDescription 
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Education Tab -->
        <div class="tab-content" id="education">
            <div class="timeline" data-aos="fade-up">
                @foreach (var education in Model.educationDtos.OrderByDescending(x=>x.DisplayOrder))
                {
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <span class="timeline-date">@education.EducationStartDate?.ToString("dd MMMM yyyy") - @education.EducationFinishDate?.ToString("dd MMMM yyyy")</span>
                            <h4>@education.EducationDegree</h4>
                            <h5>@education.EducationSchoolName</h5>
                            <p>
                                @education.EducationDescription
                            </p>
                        </div>
                    </div>
                }
               
                
            </div>
        </div>

        <!-- Certificates Tab -->
        <div class="tab-content" id="certificates">
            <div class="row g-4" data-aos="fade-up">
                @foreach (var certificates in Model.certificateDtos)
                {
                    <div class="col-md-6">
                        <div class="timeline-content">
                            <span class="timeline-date">@certificates.IssueDate?.ToString("dd MMMM yyyy") - @certificates.ExpiryDate?.ToString("dd MMMM yyyy")</span>
                            <h4>@certificates.CertificateName</h4>
                            <h5>@certificates.IssuingCompany</h5>
                            <p>@certificates.CertificateDescription</p>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Download CV -->
        <div class="text-center mt-5" data-aos="fade-up">
            <a href="assets/cv-baran-dasdemir.pdf" class="btn-primary-custom" download>
                <i class="fas fa-download me-2"></i>CV İndir (PDF)
            </a>
        </div>
    </div>
</section>

@section scripts {
    <script src="~/Mytheme/portfolio/js/resume.js"></script>
}