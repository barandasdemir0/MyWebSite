@model AboutViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link rel="stylesheet" href="~/Mytheme/portfolio/css/sections/hero.css">
    <link rel="stylesheet" href="~/Mytheme/portfolio/css/sections/sections.css">
}

<!-- PAGE HEADER -->
<section class="section" style="padding-top: 150px; padding-bottom: 20px; background: var(--bg-secondary);">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-subtitle">Beni Tanıyın</p>
            <h1 class="section-title">Hakkımda</h1>
            <div class="section-line"></div>
        </div>
    </div>
</section>


    <!-- ABOUT CONTENT -->
    <section class="section about-section" style="padding-top: 40px;">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-5" data-aos="fade-right">
                    <div class="about-image-wrapper">
                        <div class="about-image">
                        <img src="@Model.About?.ProfileImage"
                                 alt="Baran Dasdemir">
                        </div>
                    </div>
                </div>
                <div class="col-lg-7" data-aos="fade-left">
                    <div class="about-content">

                    <h2>Merhaba, Ben <span class="gradient-text">@Model.About?.FullName</span></h2>

                    <p class="about-text">@Model.About?.Greeting</p>
                    <p class="about-text">@Model.About?.Bio</p>

                        <div class="about-info">

                            <div class="info-item">
                                <i class="fas fa-user"></i>
                            <span><strong>İsim:</strong> @Model.About?.FullName</span>
                            </div>

                           
                                <div class="info-item">
                                    <i class="fas fa-envelope"></i>
                            <span><strong>Email:</strong> @Model.Contact?.Email</span>
                                </div>

                                <div class="info-item">
                                    <i class="fas fa-map-marker-alt"></i>
                            <span><strong>Konum:</strong> @Model.Contact?.Location</span>
                                </div>
                            

                           
                                <div class="info-item">
                                    <i class="fas fa-briefcase"></i>
                            <span><strong>Durum:</strong> @Model.SiteSetting?.WorkStatus</span>
                                </div>
                            

                        </div> <!-- about-info -->

                    </div> <!-- about-content -->

        
                <a href="/Home/DownloadCv" class="btn-primary-custom" target="_blank" download>
                    <i class="fas fa-download me-2"></i>CV İndir
                </a>

               
                </div>
            </div>
        </div>

    </section>



<!-- SKILLS SECTION -->
<section class="section skills-section">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-subtitle">Yeteneklerim</p>
            <h2 class="section-title">Teknik <span class="gradient-text">Beceriler</span></h2>
            <div class="section-line"></div>
        </div>

        <div class="row g-4">
            @foreach (var Categories in Model.jobSkillCategoryDtos)
            {
                <!-- Frontend -->
                <div class="col-md-6 col-lg-3" data-aos="fade-up" data-aos-delay="0">
                    <div class="skill-card">
                        <span class="iconify"
                              data-icon="@Categories.CategoryIcon"
                              data-width="48"
                              data-height="48"></span>
                        <h4>@Categories.CategoryName</h4>
                        <p>@Categories.CategoryDescription</p>
                        <div class="skill-progress">
                            @foreach (var skills in Model.jobSkillDtos.Where(x => x.JobSkillCategoryId == Categories.Id))
                            {
                                <div class="progress-item">
                                    <div class="progress-header">
                                        <span class="progress-title">@skills.JobSkillName</span><span class="progress-percent">@skills.JobSkillPercentage%</span>
                                    </div>
                                    <div class="progress-bar-wrapper">
                                        <div class="progress-bar-fill" data-width="@skills.JobSkillPercentage"></div>
                                    </div>
                                </div>
                            }

                           
                        </div>
                    </div>
                </div>
            }
           
        </div>
    </div>
</section>




    <!-- COUNTERS -->
    <section class="counters-section">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-6 col-md-4" data-aos="fade-up">
                    <div class="counter-item">
                        <div class="counter-icon"><i class="fas fa-code"></i></div>
                    <div class="counter-number" data-target="@Model.About?.ProjectCount">@Model.About?.ProjectCount</div>
                        <div class="counter-label">Proje</div>
                    </div>
                </div>
                <div class="col-6 col-md-4" data-aos="fade-up" data-aos-delay="100">
                    <div class="counter-item">
                        <div class="counter-icon"><i class="fas fa-calendar-alt"></i></div>
                    <div class="counter-number" data-target="@Model.About?.ExperienceYear">@Model.About?.ExperienceYear</div>
                        <div class="counter-label">Yıl Deneyim</div>
                    </div>
                </div>
                <div class="col-6 col-md-4" data-aos="fade-up" data-aos-delay="200">
                    <div class="counter-item">
                        <div class="counter-icon"><i class="fas fa-mug-hot"></i></div>
                    <div class="counter-number" data-target="@Model.About?.ProjectDrink">@Model.About?.ProjectDrink</div>
                        <div class="counter-label">Çay</div>
                    </div>
                </div>
            </div>
        </div>
    </section>

