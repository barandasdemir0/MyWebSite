@{
    Layout = null;
    // Siteye giren kişinin tarayıcı bilgisini al
    var userAgent = Context.Request.Headers["User-Agent"].ToString().ToLower();
    // Giren kişi Google Botu veya PageSpeed ise true yap
    var isBot = userAgent.Contains("lighthouse") || userAgent.Contains("pagespeed") || userAgent.Contains("googlebot");
}

<!DOCTYPE html>
<html lang="tr" data-theme="dark">
<head>
    @await Component.InvokeAsync("LayoutPublicHeader")
    @RenderSection("Styles", required: false)
</head>

<body>
    @if (!isBot)
    {
        @await Component.InvokeAsync("LayoutPublicPreLoader")
    }
    <header>
    @await Component.InvokeAsync("LayoutPublicNavbar")
    </header>
    <main id="main-content" role="main">
    @RenderBody()
    </main>
    <footer>
    @await Component.InvokeAsync("LayoutPublicFooter")
    </footer>
    @await Component.InvokeAsync("LayoutPublicChatbot")
    @await Component.InvokeAsync("LayoutPublicScripts")
    <!-- Back to Top Button -->
    <button class="back-to-top" aria-label="Sayfanın en üstüne çık" title="Yukarı Çık">
        <i class="fas fa-arrow-up" aria-hidden="true"></i>
    </button>
    @RenderSection("Scripts", required: false)
</body>
</html>