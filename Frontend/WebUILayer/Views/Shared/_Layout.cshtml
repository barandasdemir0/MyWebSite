@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr" data-theme="dark">

<head>
    @await Component.InvokeAsync("LayoutPublicHeader")
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="/Mytheme/portfolio/css/themes.css">
    <link rel="stylesheet" href="/Mytheme/portfolio/css/responsive.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

</head>

<body>
   
    @await Component.InvokeAsync("LayoutPublicPreLoader")
    @await Component.InvokeAsync("LayoutPublicNavbar")

  
    @RenderBody()


    @await Component.InvokeAsync("LayoutPublicFooter")


    @await Component.InvokeAsync("LayoutPublicChatbot")

    @inject Microsoft.Extensions.Configuration.IConfiguration Configuration
    <script>
        // Eğer appsettings.json'da "ApiBaseUrl" yoksa varsayılan olarak localhost kullan.
        window.AppConfig = {
        ApiUrl: "@Configuration["ApiBaseUrl"]" || "http://localhost:5028"
        };
    </script>

    @await Component.InvokeAsync("LayoutPublicScripts")


    <!-- Back to Top Button -->
    <button class="back-to-top" aria-label="Back to top">
        <i class="fas fa-arrow-up"></i>
    </button>
  
   
    @RenderSection("Scripts", required: false)
    


</body>

</html>