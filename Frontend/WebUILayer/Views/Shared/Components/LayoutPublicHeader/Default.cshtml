@model SiteSettingDto
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- 1. Temel SEO Etiketleri (Veritabanından) -->
<title>@(string.IsNullOrEmpty(Model.SiteTitle) ? "Baran Dasdemir | Portfolyo" : Model.SiteTitle)</title>
<meta name="description" content="@(string.IsNullOrEmpty(Model.MetaDescription) ? "Baran Dasdemir Professional Portfolio" : Model.MetaDescription)">
<meta name="keywords" content="@(string.IsNullOrEmpty(Model.SiteKeywords) ? "Web Developer, Software" : Model.SiteKeywords)">
<meta name="author" content="Baran Dasdemir">
<!-- 2. Tema Rengi -->
<meta name="theme-color" content="#0f0f23">
<!-- 3. Open Graph (Sosyal Medya - WhatsApp, LinkedIn Paylaşım Önizlemeleri) -->
<meta property="og:title" content="@Model.SiteTitle">
<meta property="og:description" content="@Model.MetaDescription">
<meta property="og:type" content="website">
<meta property="og:url" content="https://www.barandasdemir.com">
@if (!string.IsNullOrEmpty(Model.DefaultSeoImageUrl))
{
    <meta property="og:image" content="@Model.DefaultSeoImageUrl">
    <meta name="twitter:image" content="@Model.DefaultSeoImageUrl">
}

<!-- Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>
<link rel="preconnect" href="https://api.barandasdemir.com">
<link rel="preconnect" href="https://resmim.net">





<!-- Google Fonts -->
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<!-- Bootstrap (İskelet olduğu için NORMAL yükle) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- AOS (Resimlerin görünmesi için NORMAL yükle) -->
<link rel="stylesheet" href="https://unpkg.com/aos@2.3.4/dist/aos.css">
<!-- Font Awesome (İkonlar 1 sn geç gelse de olur, ERTELEMELİ kalsın) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" media="print" onload="this.media='all'">
<!-- Devicons (ERTELEMELİ kalsın) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/devicon.min.css" media="print" onload="this.media='all'">


<!-- Iconify (defer - render engellemez) -->
<script src="https://code.iconify.design/3/3.1.1/iconify.min.js" defer></script>

<!-- ★ TEK CSS BUNDLE — 28 dosya 1'e indi ★ -->
<link rel="stylesheet" href="/css/bundle.css">
