@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

<!-- ============================================
     APP CONFIG (JS Dosyalarından ÖNCE Yüklenmeli)
     ============================================ -->
<!-- _Layout.cshtml içinde script kısmını bu hale getir -->
<script>
    // appsettings'ten gelen URL'yi al (Örn: https://api.barandasdemir.com/api/)
    const rawApiUrl = "@Configuration["ApiSettings:BaseUrl"]" || "http://localhost:5028/api/";
    
    window.AppConfig = {
        // SignalR için sondaki "/api/" kısmını atıp "/chatHub" ekliyoruz
        HubUrl: rawApiUrl.replace(/\/api\/?$/, '') + "/chatHub"
    };
</script>

<!-- ============================================
     SCRIPTS
     ============================================ -->
<!-- Bootstrap 5.3 JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

<!-- AOS - Animate On Scroll -->
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

<!-- Custom JS -->
<!-- Theme Script - Load First -->
<script src="/Mytheme/portfolio/js/theme.js"></script>

<script src="/Mytheme/portfolio/js/animations.js"></script>
<script src="/Mytheme/portfolio/js/main.js"></script>
<script src="/Mytheme/portfolio/js/github.js"></script>
<script src="/Mytheme/portfolio/js/language.js"></script>
<script src="/Mytheme/portfolio/js/chatbot.js"></script>
<script src="/js/site.js"></script>
