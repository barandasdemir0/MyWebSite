@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@model SiteSettingDto

<!-- ============================================
     APP CONFIG (JS Dosyalarından ÖNCE Yüklenmeli)
     ============================================ -->
<!-- _Layout.cshtml içinde script kısmını bu hale getir -->
<script>
    // appsettings'ten gelen URL'yi al (Örn: https://api.barandasdemir.com/api/)
    const rawApiUrl = "@Configuration["ApiSettings:BaseUrl"]" || "http://localhost:5028/api/";
    
    window.AppConfig = {
        // SignalR için sondaki "/api/" kısmını atıp "/chatHub" ekliyoruz
        HubUrl: rawApiUrl.replace(/\/api\/?$/, '') + "/chatHub"
    };
</script>

<!-- ============================================
     SCRIPTS
     ============================================ -->
<!-- Bootstrap 5.3 JS -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" defer></script>

<!-- AOS - Animate On Scroll -->
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js" defer></script>

<!-- Custom JS -->
<!-- Theme Script - Load First -->
<script src="/Mytheme/portfolio/js/theme.js" defer></script>

<script src="/Mytheme/portfolio/js/animations.js" defer></script>
<script src="/Mytheme/portfolio/js/main.js" defer></script>
<script src="/Mytheme/portfolio/js/github.js" defer></script>
<script src="/Mytheme/portfolio/js/language.js" defer></script>
<script src="/Mytheme/portfolio/js/chatbot.js" defer></script>
<script src="/js/site.js" defer></script>
<div id="analytics-data" data-ga-id="@Model.GoogleAnalyticsId" data-clarity-id="@Model.MicrosoftClarityId" style="display:none;"></div>
