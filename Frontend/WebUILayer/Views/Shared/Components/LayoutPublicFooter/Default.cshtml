@model FooterViewModel

<footer class="footer">
    <div class="container">
        <div class="footer-content">
            <!-- Brand -->
            <div class="footer-brand">
                <h3><span>B</span>aran<span>.</span></h3>
                <p>Modern teknolojilerle web, mobil ve Yapay Zeka çözümleri geliştiren tutkulu bir developer.</p>
                <div class="footer-social">
                    @foreach (var social in Model.SocialMedias)
                    {
                        <a href="@social.SocialMediaUrl" target="_blank" rel="noopener" aria-label="@social.SocialMediaName">
                            <span class="iconify"
                                  data-icon="@social.SocialMediaIcon"
                                  data-width="14"
                                  data-height="14"></span>
                        </a>
                    }
                   

                </div>
            </div>

            <!-- Quick Links -->
            <div class="footer-links">
                <h4>Hızlı Linkler</h4>
                <ul>
                    <li><a href="/Home/Index/">Ana Sayfa</a></li>
                    <li><a href="/About/Index/">Hakkımda</a></li>
                    <li><a href="/Resume/Index/">Özgeçmiş</a></li>
                    <li><a href="/Contact/Index/">İletişim</a></li>
                </ul>
            </div>

            <!-- Resources -->
            <div class="footer-links">
                <h4>Kaynaklar</h4>
                <ul>
                    <li><a href="/Home/DownloadCv" target="_blank" download>CV İndir</a>
                    </li>
                    <li><a href="/Blog/Index/">Blogum</a></li>
                    <li><a href="/Project/Index/">Projelerim</a></li>
                    <li><a href="/Guestbook/Index/">Ziyaret Defteri</a></li>
                </ul>
            </div>

            <!-- Contact Info -->
            <div class="footer-links">
                <h4>İletişim</h4>
                <ul>
                    <li><i class="fas fa-envelope me-2"></i>@Model.Contacts?.Email</li>
                    <li><i class="fas fa-phone me-2"></i>@Model.Contacts?.Phone</li>
                    <li><i class="fas fa-map-marker-alt me-2"></i>@Model.Contacts?.Location</li>
                </ul>
            </div>
        </div>

        <!-- Footer Bottom -->
        <div class="footer-bottom">
            <p class="footer-copyright">
                © @DateTime.UtcNow.Year Baran Dasdemir. Made with <span>❤️</span> in @Model.Contacts?.Location
            </p>
        </div>
    </div>
</footer>