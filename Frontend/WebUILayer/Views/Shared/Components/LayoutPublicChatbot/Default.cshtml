@model UpdateChatbotSettingsDto
<button class="chatbot-toggle" aria-label="Sohbet Aç">
    <i class="fas fa-comment-dots"></i>
    <span class="badge">1</span>
</button>

<div class="chatbot-window">
    <div class="chatbot-header">
        <div class="chatbot-avatar">🤖</div>
        <div class="chatbot-info">
            <h4>@Model?.AssistantName</h4>
            <span>Genellikle hemen yanıt verir</span>
        </div>
        <button class="chatbot-close" aria-label="Kapat">
            <i class="fas fa-times"></i>
        </button>
    </div>
    <div class="chatbot-messages">
        <div class="chat-message bot">
            <div class="message-avatar">🤖</div>
            <div class="message-content">
                @Model?.WelcomeMessage
            </div>
        </div>
    </div>
    <div class="chatbot-input">
        <input type="text" id="chatbotInput" name="chatbotMessage" placeholder="Mesajınızı yazın..." />
        <button class="chatbot-send" aria-label="Gönder">
            <i class="fas fa-paper-plane"></i>
        </button>
    </div>
</div>