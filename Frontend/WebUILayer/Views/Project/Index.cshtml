@model ProjectViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
}

<!-- PAGE HEADER -->
<section class="section project-header-section" style="background: var(--bg-secondary);">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-subtitle">Çalışmalarım</p>
            <h1 class="section-title">Projeler</h1>
            <div class="section-line"></div>
        </div>
    </div>
</section>

<!-- PORTFOLIO SECTION -->
<section class="section portfolio-section" style="padding-top: 40px;">
    <div class="container">
        <!-- Search Box -->
        <div class="search-box" data-aos="fade-up" id="portfolioSearch">
            <input type="text" class="search-input" id="portfolioSearchInput" placeholder="Projelerde ara...">
            <button class="search-clear" id="portfolioSearchClear"><i class="fas fa-times"></i></button>
            <i class="fas fa-search search-icon"></i>
        </div>

        <!-- Category Filters -->
        <div class="portfolio-filters" data-aos="fade-up" style="margin-bottom: 50px;">
            <button class="filter-btn active" data-filter="*">Tümü</button>
            @foreach (var topic in Model.topicDtos)
            {
                <button class="filter-btn" data-filter="@topic.Name">@topic.Name</button>
            }
          
        </div>

        <!-- Portfolio Grid -->
        <div class="portfolio-grid">
            @foreach (var project in Model.projectDtos)
            {
                <div class="portfolio-item portfolio-card" data-category="@string.Join(",", project.Topics)" data-aos="fade-up">

                    <div class="portfolio-image">
                        <img src="@project.ImageUrl" alt="@project.Name">
                        <div class="portfolio-overlay">
                            <a href="/Project/ProjectDetail/@project.Slug" class="btn-icon">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="@project.WebsiteUrl" target="_blank" class="btn-icon"><i class="fas fa-external-link-alt"></i></a>
                        </div>
                    </div>
                    <div class="portfolio-info">
                        <span class="portfolio-category">@string.Join(", ", project.Topics)</span>
                        <h4>@project.Name</h4>
                     
                        <div class="portfolio-tags">
                          
                                @foreach (var lang in project.Technologies.Split(','))
                                {
                                    <span class="portfolio-tag">@lang.Trim()</span>
                                }
                          
                        </div>
                        
                    </div>
                </div>
            }

        </div>

       
        <div class="mt-4" data-aos="fade-up">
            @await Component.InvokeAsync("LayoutPublicPagination", new { currentPage = Model.CurrentPage, totalPages = Model.TotalPages })
        </div>
    </div>
</section>

@section scripts {
    <script src="~/Mytheme/portfolio/js/portfolio.js"></script>
}
