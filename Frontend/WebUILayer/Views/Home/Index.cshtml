@model IndexViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
}

<!-- ============================================
        HERO SECTION
        ============================================ -->
<section class="hero-section" id="hero">
    <!-- Animated Background Shapes -->
    <div class="hero-bg-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>

    <!-- Hero Content -->
    <div class="hero-content" >
        <p class="hero-subtitle">Merhaba, Ben</p>
        <h1 class="hero-title">
            <span class="name">@Model.heroDto?.FullName</span>
        </h1>
        <div class="hero-typed">
            <span class="typed-text" data-words="@Model.heroDto?.ScrollingText"></span>
        </div>
        @*   <p class="hero-description">
            @Model.heroDto?.ProfessionalTitle
        </p> *@

        <!-- CTA Buttons -->
        <div class="hero-buttons">
            <a href="/project/Index/" class="btn-primary-custom">
                <i class="fas fa-rocket me-2"></i>Projelerim
            </a>
            <a href="/Home/DownloadCv" class="btn-outline-custom" target="_blank" download>
                <i class="fas fa-download me-2"></i>CV İndir
            </a>
            <a href="/Contact/Index/" class="btn-outline-custom">
                <i class="fas fa-envelope me-2"></i>İletişim
            </a>
        </div>

        <!-- Social Links -->
        <div class="hero-social">
   
            @foreach (var item in Model.socialMediaDtos)
            {
                <a href="@item.SocialMediaUrl" target="_blank" rel="noopener" aria-label="@item.SocialMediaName">
                    <span class="iconify"
                          data-icon="@item.SocialMediaIcon"
                          data-width="48"
                          data-height="48"></span>
                </a>
            }
        </div>

        <!-- Availability Status -->
        <!-- Availability Status -->
        <div class="hero-availability">
            <div class="availability-badge @(Model.siteSettingDto?.IsAvailable == true ? "available" : "busy")">
                <span class="status-dot"></span>
                <span class="status-text">@Model.siteSettingDto?.WorkStatus</span>
            </div>
        </div>
    </div>
</section>

<!-- ============================================
     QUICK ABOUT PREVIEW (Optional Section)
     ============================================ -->
<section class="section about-section" id="about-preview">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6" data-aos="fade-right">
                <div class="about-image-wrapper">
                    <div class="about-image">
                        <img src="@Model.aboutDto?.ProfileImage" alt="@Model.aboutDto?.FullName"
                             width="585" height="585" fetchpriority="high"
                             sizes="(max-width: 768px) 334px, 585px">
                    </div>
                </div>
            </div>
            <div class="col-lg-6" data-aos="fade-left">
                <div class="about-content">
                    <p class="section-subtitle">Hakkımda</p>
                    <h2 class="section-title">Tutkulu Bir <span class="gradient-text">Developer</span></h2>
                    <p class="about-text">
                        @Model.aboutDto?.Greeting
                    </p>
                    <p class="about-text">
                        @Model.aboutDto?.Bio
                    </p>
                    <a href="/About/Index/" class="btn-primary-custom">
                        <i class="fas fa-user me-2"></i>Daha Fazla Bilgi
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================
     TECH STACK MARQUEE
     ============================================ -->
<section class="marquee-section">
    <div class="marquee-title" data-aos="fade-up">
        <h3>Kullandığım Teknolojiler</h3>
    </div>
    <div class="marquee-wrapper">
        <div class="marquee-content">
            <!-- First set -->
            @foreach (var skills in Model.skillDtos)
            {
                <div class="marquee-item">
                    <span class="iconify"
                          data-icon="@skills.IconifyIcon"
                          data-width="48"
                          data-height="48">@skills.IconifyIcon</span>
                </div>
            }
            <!-- Duplicate for seamless loop -->
            @foreach (var skills in Model.skillDtos)
            {
                <div class="marquee-item">
                    <span class="iconify"
                          data-icon="@skills.IconifyIcon"
                          data-width="48"
                          data-height="48">@skills.IconifyIcon</span>
                </div>
            }
        
        </div>
    </div>
</section>

<!-- ============================================
     COUNTERS SECTION
     ============================================ -->
<section class="counters-section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-6 col-md-4" data-aos="fade-up" data-aos-delay="0">
                <div class="counter-item">
                    <div class="counter-icon"><i class="fas fa-code"></i></div>
                    <div class="counter-number" data-target="@Model.aboutDto?.ProjectCount">@Model.aboutDto?.ProjectCount</div>
                    <div class="counter-label">Proje</div>
                </div>
            </div>
            <div class="col-6 col-md-4" data-aos="fade-up" data-aos-delay="100">
                <div class="counter-item">
                    <div class="counter-icon"><i class="fas fa-calendar-alt"></i></div>
                    <div class="counter-number" data-target="@Model.aboutDto?.ExperienceYear">@Model.aboutDto?.ExperienceYear</div>
                    <div class="counter-label">Yıl Deneyim</div>
                </div>
            </div>
            <div class="col-6 col-md-4" data-aos="fade-up" data-aos-delay="200">
                <div class="counter-item">
                    <div class="counter-icon"><i class="fas fa-mug-hot"></i></div>
                    <div class="counter-number" data-target="@Model.aboutDto?.ProjectDrink">@Model.aboutDto?.ProjectDrink</div>
                    <div class="counter-label">Çay</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================
     FEATURED PROJECTS PREVIEW
     ============================================ -->
<section class="section portfolio-section" id="projects-preview">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <p class="section-subtitle">Portföy</p>
            <h2 class="section-title">Öne Çıkan <span class="gradient-text">Projeler</span></h2>
            <div class="section-line"></div>
        </div>

        <div class="portfolio-grid">
            @foreach (var project in Model.projectListDtos)
            {
                <!-- Project 1 -->
                <div class="portfolio-card" data-aos="fade-up" data-aos-delay="0">
             
                    <div class="portfolio-image">
                        <img src="@project.ImageUrl" alt="@project.Name"
                             width="662" height="373" loading="lazy" decoding="async">
                        <div class="portfolio-overlay">
                            <a href="/Project/ProjectDetail/@project.Slug" class="btn-icon" title="Detay"><i class="fas fa-eye"></i></a>
                            <a href="@project.WebsiteUrl" class="btn-icon" title="Demo"><i class="fas fa-external-link-alt"></i></a>
                        </div>
                    </div>
                    <div class="portfolio-info">
                        <span class="portfolio-category">@string.Join(", ", project.Topics)</span>
                        <h4>@project.Name</h4>
                        <div class="portfolio-tags">
                            @foreach (var lang in project.TechnologyList)
                            {
                                <span class="portfolio-tag">@lang</span>
                            }
                        </div>
                    </div>

             
                </div>
            }
        </div>

        <div class="text-center mt-5" data-aos="fade-up">
            <a href="/Project/Index/" class="btn-primary-custom">
                <i class="fas fa-th me-2"></i>Tüm Projeleri Gör
            </a>
        </div>
    </div>
</section>

<!-- ============================================
     TESTIMONIALS SECTION
     ============================================ -->
<section class="section testimonials-section" id="testimonials">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            <p class="section-subtitle">Referanslar</p>
            <h2 class="section-title">Geçmiş <span class="gradient-text">Deneyimler</span></h2>
            <div class="section-line mx-auto"></div>
        </div>

        <div class="row justify-content-center mt-5">
            <div class="col-lg-10" data-aos="fade-up" data-aos-delay="100">
                <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                    <div class="carousel-inner">

                        @foreach (var guestBook in Model.guestBookListDtos)
                        {
                            <!-- Testimonial 1 -->
                            <div class="carousel-item active">
                                <div class="testimonial-card text-center">
                                    <div class="testimonial-avatar mb-4 d-inline-block">
                                        <img src="@guestBook.AuthorAvatarUrl" alt="@guestBook.AuthorName"
                                             width="80" height="80" loading="lazy">
                                    </div>
                                    <p class="testimonial-text">
                                        @guestBook.Message
                                    </p>
                                    <div class="testimonial-info">
                                        <h5 class="testimonial-name">@guestBook.AuthorName</h5>
                                    </div>
                                </div>
                            </div>
                        }

                       
                    </div>

                    <!-- Controls -->
                    <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel"
                            data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel"
                            data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>

                    <!-- Indicators -->
                    <div class="carousel-indicators" style="bottom: -50px;">
                        <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="0"
                                class="active" aria-current="true" aria-label="Slide 1"></button>
                        <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="1"
                                aria-label="Slide 2"></button>
                        <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="2"
                                aria-label="Slide 3"></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================
     GITHUB PROJECTS SECTION
     ============================================ -->
<section class="section github-section" id="github">
    <div class="container">
        <div class="section-header text-center" data-aos="fade-up">
            <p class="section-subtitle">Open Source</p>
            <h2 class="section-title">GitHub <span class="gradient-text">Kod Paylaşımları</span></h2>
            <div class="section-line mx-auto"></div>
            <p class="text-center mt-3"
                   style="max-width: 600px; margin-left: auto; margin-right: auto; color: var(--text-secondary);">
                En güncel açık kaynak projelerim ve kod denemelerim.
            </p>
        </div>

        <!-- GitHub Grid - Fallback Static Cards -->
        <div class="github-grid" id="github-projects-grid">
            @foreach (var repo in Model.githubRepoDtos)
            {
                <!-- Repo 1 -->
                <div class="github-card" data-aos="fade-up">
                    <div class="github-card-header">
                        <i class="fas fa-book-bookmark"></i>
                        <h4><a href="@repo.RepoUrl" target="_blank">@repo.RepoName</a></h4>
                    </div>
                    <p class="github-card-desc">
                        @repo.Description
                    </p>
                    <div class="github-card-footer">
                        <span class="github-lang">
                            <span class="lang-dot" style="background: #f1e05a;"></span>
                            @repo.Language
                        </span>
                        <span class="github-stat"><i class="far fa-star"></i> @repo.StarCount</span>
                        <span class="github-stat"><i class="fas fa-code-branch"></i> @repo.ForkCount</span>
                    </div>
                </div>
            }

           

        </div>

        <div class="text-center mt-5" data-aos="fade-up">
            <a href="https://github.com/barandasdemir0" target="_blank" class="btn-outline-custom">
                <i class="fab fa-github me-2"></i>Tüm Repoları Gör
            </a>
        </div>
    </div>
</section>

<!-- ============================================
     CTA SECTION
     ============================================ -->
<section class="section cta-section" style="background: var(--bg-secondary);">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 text-center" data-aos="fade-up">
                <h2 class="section-title mb-4">Projeniz İçin <span class="gradient-text">Hazırım</span></h2>
                <p class="mb-4" style="color: var(--text-secondary); font-size: 1.1rem;">
                    İster yeni bir proje ister mevcut bir projenin geliştirilmesi olsun,
                    fikirlerinizi hayata geçirmek için buradayım.
                </p>
                <a href="/Contact/Index/" class="btn-primary-custom">
                    <i class="fas fa-paper-plane me-2"></i>Hemen İletişime Geç
                </a>
            </div>
        </div>
    </div>
</section>

