  },
  "AdminSettings": {
    "NotificationEmail": "barandasdemir.bd@gmail.com",
    "FullName": "Baran Daşdemir"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning", // Sadece Warning ve Error'ları logla
      "Override": {
        "Microsoft": "Error", // Microsoft'un gereksiz Information'larını sadece Error ise logla
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "SqlServer",
          "sinkOptionsSection": {
            "tableName": "Logs",
            "autoCreateSqlTable": true
          },
          "columnOptionsSection": {
            "timeStamp": { "columnName": "CreatedAt" },
            "removeStandardColumns": [ "MessageTemplate", "Properties", "Id" ] // <--- Buraya "Id" ekledik
          }
        }
      }
    ]
  }
}
